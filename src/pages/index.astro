---
import Base from '../layouts/Base.astro';
import { projects, awards, site, graphic, side, earlier } from '../data/projects';
---
<Base>
  <!-- ───────── HERO ───────── -->
  <section class="hero wrap" data-hero>
    <div class="hero__top mono">
      <span data-reveal>Digital, Graphic<br />&amp; Product Design</span>
      <span data-reveal class="hide-sm">Miami, FL<br />Remote worldwide</span>
    </div>

    <h1 class="display h-xl hero__title" data-split data-split-now>
      Joaquin<br />Böhmer
    </h1>

    <div class="hero__bottom">
      <p class="hero__lead" data-reveal>
        I’m {site.name.split(' ')[0]}, a designer who takes ideas from research to design to <em>production code</em>. My work has won Red&nbsp;Dot and Indigo awards.
      </p>

      <div class="hud mono" data-reveal aria-hidden="true">
        <div class="hud__meters">
          <div class="meter"><span>Low</span><i data-band="low"></i></div>
          <div class="meter"><span>Mid</span><i data-band="mid"></i></div>
          <div class="meter"><span>High</span><i data-band="high"></i></div>
        </div>
        <p class="dim hud__hint"><span class="hint-fine">Move and scroll to play the visuals.</span><span class="hint-touch">Tap to play the visuals.</span></p>
      </div>
    </div>

  </section>

  <!-- ───────── INTRO ───────── -->
  <section class="intro wrap">
    <p class="mono dim" data-reveal>Approach</p>
    <p class="lead intro__text" data-split>
      I don’t stop at the handoff. I design the product and then build it, so what ships is what was designed.
    </p>
    <div class="intro__cols">
      <p class="body-lg" data-reveal>
        My background spans UX, brand and graphic design from SCAD, live visuals as a VJ, and full-stack builds for real businesses. That mix means I can own a problem end to end: talk to the people who have it, design the system, and ship the software.
      </p>
      <a href="/about" class="btn" data-reveal>More about me <span class="arrow">↗</span></a>
    </div>
  </section>

  <!-- ───────── WORK INDEX ───────── -->
  <section class="work wrap" id="work">
    <div class="work__head">
      <p class="mono dim" data-reveal>Selected work</p>
      <p class="mono dim" data-reveal>{String(projects.length).padStart(2, '0')} projects</p>
    </div>
    <hr class="rule" data-draw />
    <ul class="work__list" role="list">
      {projects.map((p) => (
        <li>
          <a
            href={`/work/${p.slug}`}
            class="row"
            data-project
            data-title={p.title}
            data-palette={p.palette.join(',')}
            data-cover={p.cover.src}
           
            style={`--p1:${p.palette[0]};--p2:${p.palette[1]}`}
          >
            <span class="row__idx mono">{p.index}</span>
            <span class="row__title display h-lg">{p.title}</span>
            <span class="row__meta mono">
              <span>{p.type}</span>
              {p.award && <span class="tag">★ {p.award}</span>}
              <span class="dim">{p.year}</span>
            </span>
            <span class="row__kicker">{p.kicker}</span>
            <span class="row__thumb" aria-hidden="true">{p.cover.src ? <img src={p.cover.src} alt="" loading="lazy" /> : <span class="gen" style={`--p3:${p.palette[2]}`}></span>}</span>
          </a>
          <hr class="rule" data-draw />
        </li>
      ))}
    </ul>
    <div class="preview" aria-hidden="true">
      <div class="gen"></div>
      <img alt="" hidden />
      <span class="preview__title mono"></span>
    </div>
  </section>

  <!-- ───────── SIDE PROJECTS ───────── -->
  <section class="side wrap" id="side">
    <div class="work__head">
      <p class="mono dim" data-reveal>Side projects</p>
      <p class="mono dim" data-reveal>Small tools and apps</p>
    </div>
    <hr class="rule" data-draw />
    <div class="side__grid">
      {side.map((sp) => (
        <article class="side__item" data-reveal>
          <a href={sp.link?.href ?? sp.img} target={sp.link ? '_blank' : undefined} rel="noopener" class:list={['side__img', { 'side__img--contain': !!sp.bg }]} style={sp.bg ? `background:${sp.bg}` : undefined}>
            <img src={sp.img} width={sp.w} height={sp.h} alt={`${sp.title} screenshot`} loading="lazy" decoding="async" />
          </a>
          <div class="side__text">
            <h3 class="display side__title">{sp.title}</h3>
            <p class="mono dim">{sp.type}</p>
            {sp.body.map((b) => <p class="side__body">{b}</p>)}
            {sp.link ? <a class="btn" href={sp.link.href} target="_blank" rel="noopener">{sp.link.label} <span class="arrow">↗</span></a> : <span class="mono dim">In use by a client · Private</span>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ───────── EARLIER WORK ───────── -->
  <section class="earlier wrap" id="earlier">
    <div class="work__head">
      <p class="mono dim" data-reveal>Earlier work</p>
      <p class="mono dim" data-reveal>Product concepts from SCAD</p>
    </div>
    <hr class="rule" data-draw />
    <div class="earlier__grid">
      {earlier.map((e) => (
        <article class="earlier__item" data-reveal>
          <div class="earlier__imgs">
            {e.imgs.map((im) => im.src.endsWith('.mp4')
              ? <video src={im.src} poster={im.poster} width={im.w} height={im.h} aria-label={im.alt} autoplay muted loop playsinline preload="none"></video>
              : <img src={im.src} width={im.w} height={im.h} alt={im.alt} loading="lazy" decoding="async" />)}
          </div>
          <div class="earlier__text">
            <h3 class="display earlier__title">{e.title}</h3>
            <p class="mono dim">{e.type} · {e.year}</p>
            <p class="earlier__body">{e.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ───────── GRAPHIC & PRINT ───────── -->
  <section class="graphic wrap" id="graphic">
    <div class="work__head">
      <p class="mono dim" data-reveal>Graphic &amp; print</p>
      <p class="mono dim" data-reveal>Posters · Editorial · Campaigns · Type</p>
    </div>
    <hr class="rule" data-draw />
    <p class="lead graphic__intro" data-split>Posters, editorial spreads, campaigns and type.</p>
    <ul class="gallery" role="list">
      {graphic.map((g, i) => (
        <li class:list={['gallery__item', g.span && `gallery__item--${g.span}`]} data-reveal>
          <a href={g.src} data-lightbox={i} data-caption={`${g.title}: ${g.type}`} aria-label={`${g.title}: ${g.type}, view larger`}>
            <img src={g.src} width={g.w} height={g.h} alt={`${g.title}: ${g.type}`} loading="lazy" decoding="async" />
          </a>
          <p class="gallery__cap"><span>{g.title}</span><span class="mono dim">{g.type}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- lightbox -->
  <div class="lightbox" data-lightbox-root aria-hidden="true" role="dialog" aria-label="Image viewer">
    <button class="lightbox__close mono" data-lb-close>Close ✕</button>
    <button class="lightbox__nav lightbox__prev mono" data-lb-prev aria-label="Previous">←</button>
    <img alt="" />
    <button class="lightbox__nav lightbox__next mono" data-lb-next aria-label="Next">→</button>
    <p class="lightbox__cap mono"></p>
  </div>


  <!-- ───────── RECOGNITION ───────── -->
  <section class="recog wrap">
    <p class="mono dim" data-reveal>Recognition</p>
    <div class="recog__grid">
      {awards.map((a) => (
        <div class="award" data-reveal>
          <span class="display h-md">{a.name}</span>
          <span class="mono dim">{a.detail}</span>
        </div>
      ))}
      <div class="award" data-reveal>
        <span class="display h-md">2,600+</span>
        <span class="mono dim">Tickets sold at 21 events I founded &amp; produced</span>
      </div>
    </div>
  </section>
</Base>

<style>
  .hide-sm { }
  @media (max-width: 720px) { .hide-sm { display: none; } }

  /* hero */
  .hero {
    min-height: 100svh; display: flex; flex-direction: column; justify-content: space-between;
    padding-top: 84px; padding-bottom: 28px; position: relative;
  }
  .hero__top { display: flex; justify-content: space-between; gap: 16px; color: var(--fg-dim); }
  .hero__title { margin: auto 0 0; padding-top: 12vh; mix-blend-mode: difference; color: #fff; line-height: 0.98; } /* room for the ö */
  .hero__title :global(em) { font-style: normal; }
  .hero__bottom { display: flex; justify-content: space-between; align-items: end; gap: 32px; margin-top: clamp(24px, 4vw, 48px); flex-wrap: wrap; }
  .hero__lead { font-size: clamp(18px, 1.7vw, 26px); line-height: 1.3; max-width: 30ch; margin: 0; letter-spacing: -0.01em; }
  .hero__lead em { font-style: normal; color: var(--c1); transition: color 0.6s; }

  .hud { display: grid; gap: 10px; justify-items: end; }
  .hud__meters { display: flex; gap: 18px; }
  .meter { display: grid; gap: 6px; justify-items: center; color: var(--fg-dim); }
  .meter i {
    --v: 0.1;
    display: block; width: 8px; height: 64px; border: 1px solid var(--line); position: relative; overflow: hidden;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(0,0,0,0.6) 3px 4px);
  }
  .meter i::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--v) * 100%);
    background: linear-gradient(to top, #2bff88, #ffd23f 70%, var(--accent));
    background-size: 100% 64px; background-position: bottom;
  }
  @media (max-width: 720px) { .hud { justify-items: start; } }

  /* intro */
  .intro { padding-block: clamp(100px, 18vw, 260px) clamp(60px, 10vw, 140px); }
  .intro__text { font-size: clamp(30px, 4.6vw, 76px); max-width: 18ch; margin: 28px 0 clamp(36px, 6vw, 80px); }
  .intro__cols { display: flex; gap: 32px; justify-content: space-between; align-items: end; flex-wrap: wrap; margin-left: auto; max-width: 900px; }
  .intro__cols .body-lg { margin: 0; flex: 1 1 360px; }

  /* work */
  .work { padding-block: clamp(40px, 6vw, 80px); }
  .work__head { display: flex; justify-content: space-between; margin-bottom: 18px; }
  .work__list { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: 70px 1fr auto; grid-template-areas: 'idx title meta' 'idx kicker meta';
    align-items: center; gap: 4px 24px; padding: clamp(22px, 3vw, 40px) 0; position: relative;
  }
  .row__idx { grid-area: idx; align-self: start; padding-top: 0.6em; color: var(--fg-dim); }
  .row__title { grid-area: title; transition: transform 0.7s var(--ease-out), color 0.5s; transform-origin: left; }
  .row__kicker { grid-area: kicker; color: var(--fg-dim); max-width: 48ch; transition: color 0.5s; }
  .row__meta { grid-area: meta; display: grid; justify-items: end; gap: 6px; text-align: right; }
  .tag { color: #ffd23f; }
  .row:hover .row__title { transform: translateX(clamp(8px, 2vw, 32px)); color: var(--p1); }
  .row:hover .row__kicker { color: var(--fg); }
  .work__list:hover .row:not(:hover) { opacity: 0.35; }
  .row { transition: opacity 0.5s var(--ease-out); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 40px 1fr; grid-template-areas: 'idx title' 'idx kicker' 'idx meta'; }
    .row__meta { justify-items: start; text-align: left; margin-top: 10px; }
  }

  .preview {
    position: fixed; top: 0; left: 0; z-index: 30; pointer-events: none;
    width: clamp(300px, 30vw, 460px); aspect-ratio: 4/3; margin: -10% 0 0 24px; overflow: hidden; border-radius: 4px;
    opacity: 0; transform: scale(0.85); transition: opacity 0.4s var(--ease-out), scale 0.6s var(--ease-out);
    scale: 0.85;
  }
  .preview.is-on { opacity: 1; scale: 1; }
  /* show the whole cover at its real proportions (no cropping) */
  .preview:has(img:not([hidden])) { aspect-ratio: auto; }
  .preview img { position: relative; display: block; width: 100%; height: auto; }
  .preview img[hidden] { display: none; }
  .preview__title { position: absolute; left: 14px; bottom: 12px; color: #fff; mix-blend-mode: difference; }
  @media (hover: none) { .preview { display: none; } }
  .row__thumb { display: none; }
  @media (hover: none) {
    .row { grid-template-areas: 'idx title' 'idx kicker' 'idx meta' 'idx thumb'; }
    .row__thumb {
      grid-area: thumb; display: block; position: relative; overflow: hidden; border-radius: 4px; margin-top: 16px;
      aspect-ratio: 16/9; background: var(--bg-2);
      opacity: 0.35; filter: grayscale(1); transform: scale(0.97);
      transition: opacity 0.6s var(--ease-out), filter 0.6s, transform 0.8s var(--ease-out);
    }
    .row__thumb:has(img) { aspect-ratio: auto; }
    .row__thumb img { display: block; width: 100%; height: auto; }
    .row.is-active .row__thumb { opacity: 1; filter: none; transform: none; }
    .row.is-active .row__title { color: var(--p1); transform: translateX(10px); }
    .work__list.has-active .row:not(.is-active) { opacity: 0.4; }
    .row:active { opacity: 0.7; }
  }


  /* recognition */
  .recog { padding-block: clamp(80px, 12vw, 180px) 0; }
  /* side projects */
  .side { padding-block: clamp(80px, 12vw, 160px) 0; }
  .side__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 48px); margin-top: clamp(28px, 4vw, 48px); }
  .side__item { display: grid; gap: 20px; align-content: start; }
  .side__img { display: block; overflow: hidden; border-radius: 4px; background: var(--bg-2); aspect-ratio: 16 / 9; }
  .side__img img { width: 100%; height: 100%; object-fit: cover; object-position: top left; transition: transform 0.9s var(--ease-out); }
  .side__img:hover img { transform: scale(1.03); }
  .side__img--contain img { object-fit: contain; object-position: center; }
  .side__text { display: grid; gap: 10px; justify-items: start; }
  .side__title { font-size: clamp(28px, 3vw, 44px); margin: 0; }
  .side__text .mono { margin: 0 0 6px; }
  .side__body { margin: 0; color: color-mix(in srgb, var(--fg) 80%, transparent); max-width: 52ch; line-height: 1.55; }
  .side__text .btn { margin-top: 8px; }
  @media (max-width: 860px) { .side__grid { grid-template-columns: 1fr; } }

  /* earlier work */
  .earlier { padding-block: clamp(80px, 12vw, 160px) 0; }
  .earlier__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 48px); margin-top: clamp(28px, 4vw, 48px); }
  .earlier__item { display: grid; gap: 18px; align-content: start; }
  .earlier__imgs { display: grid; grid-template-columns: 3fr 2fr; gap: 10px; align-items: stretch; }
  .earlier__imgs img, .earlier__imgs video { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; background: var(--bg-2); }
  .earlier__text { display: grid; gap: 8px; }
  .earlier__title { font-size: clamp(24px, 2.4vw, 36px); margin: 0; }
  .earlier__text .mono { margin: 0 0 4px; }
  .earlier__body { margin: 0; color: color-mix(in srgb, var(--fg) 80%, transparent); max-width: 52ch; line-height: 1.55; }
  @media (max-width: 860px) { .earlier__grid { grid-template-columns: 1fr; } }

  /* graphic */
  .graphic { padding-block: clamp(80px, 12vw, 160px) 0; }
  .graphic__intro { margin: 28px 0 clamp(36px, 5vw, 64px); max-width: 20ch; }
  /* masonry: rows are 4px tall; JS sets each item's row span from its real height */
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 4px; grid-auto-flow: dense; column-gap: clamp(10px, 1.4vw, 20px); }
  .gallery__item { padding-bottom: clamp(18px, 2vw, 28px); align-self: start; }
  .gallery__item--wide { grid-column: span 2; }
  .gallery__item--full { grid-column: 1 / -1; }
  .gallery__item a { display: block; overflow: hidden; border-radius: 4px; background: var(--bg-2); }
  .gallery__item img { display: block; width: 100%; height: auto; transition: transform 0.9s var(--ease-out); }
  .gallery__item a:hover img { transform: scale(1.03); }
  .gallery__cap { display: flex; justify-content: space-between; gap: 12px; margin: 8px 0 0; font-size: 13px; }
  .gallery__cap span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 860px) {
    .gallery { grid-template-columns: repeat(2, 1fr); }
    .gallery__item--wide, .gallery__item--full { grid-column: 1 / -1; }
    .gallery__cap { flex-direction: column; gap: 2px; font-size: 12px; }
  }
  .lightbox {
    position: fixed; inset: 0; z-index: 80; display: grid; place-items: center;
    background: rgba(5,5,7,0.94); opacity: 0; pointer-events: none; transition: opacity 0.4s var(--ease-out);
    padding: 64px clamp(16px, 6vw, 96px);
  }
  .lightbox.is-open { opacity: 1; pointer-events: auto; }
  .lightbox img { max-width: 100%; max-height: calc(100svh - 140px); object-fit: contain; }
  .lightbox__close { position: absolute; top: 18px; right: var(--gutter); }
  .lightbox__cap { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: var(--fg-dim); }
  .lightbox__nav { position: absolute; top: 50%; transform: translateY(-50%); font-size: 22px; padding: 16px; }
  .lightbox__prev { left: 8px; } .lightbox__next { right: 8px; }

  .recog__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 28px; }
  .award { background: var(--bg); padding: clamp(24px, 3vw, 44px); display: grid; gap: 40px; align-content: space-between; min-height: 220px; }
</style>
